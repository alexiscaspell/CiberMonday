# Dockerfile para el servidor CiberMonday (API Flask + panel Expo)
FROM node:22-bookworm-slim AS admin
WORKDIR /admin
COPY server/admin/package.json server/admin/package-lock.json ./
RUN npm ci
COPY server/admin/ ./
RUN npx expo export -p web

FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
COPY server/core/ ./server/core/
COPY server/web/ ./server/web/
COPY --from=admin /admin/dist/ ./server/web/static/

RUN pip install -r requirements.txt
RUN rm requirements.txt

EXPOSE 5000

ENV FLASK_APP=server/web/app.py
ENV FLASK_ENV=production
ENV PORT=5000
ENV HOST=0.0.0.0
ENV ADMIN_ALLOW_LAN=true

CMD ["python", "server/web/app.py"]
