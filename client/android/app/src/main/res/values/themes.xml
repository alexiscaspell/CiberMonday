<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CiberMondayClient" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="Theme.CiberMondayClient.Lock" parent="Theme.CiberMondayClient">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/lock_bg</item>
        <item name="android:statusBarColor">@color/lock_bg</item>
        <item name="android:navigationBarColor">@color/lock_bg</item>
    </style>
</resources>
