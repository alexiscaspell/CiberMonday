[Unit]
Description=CiberMonday Client - Control de tiempo de uso
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/cibermonday/client.py --service --platform linux
WorkingDirectory=/opt/cibermonday
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=10

# nft/iptables viven en sbin
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

ProtectSystem=strict
# config/logs/MITM CA + trust store (update-ca-certificates)
ReadWritePaths=/etc/cibermonday /usr/local/share/ca-certificates /etc/ssl/certs /etc/ca-certificates
PrivateTmp=true
# SO_MARK en dials del HostnameProxy (evita bucle nft → NS_ERROR_NET_RESET)
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cibermonday

[Install]
WantedBy=multi-user.target
